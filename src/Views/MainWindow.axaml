<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Stickies.Views.MainWindow"
        Width="280" Height="280"
        MinWidth="180" MinHeight="140"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif"
        Title="Sticky">

  <Window.Styles>
    <Style Selector="Border.iconBtn">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.iconBtn:pointerover">
      <Setter Property="Background" Value="#15000000"/>
    </Style>
  </Window.Styles>
  <Border Name="BodyBorder"
            Background="#FFF59E"
            BoxShadow="0 14 14 0 #50000000"
            CornerRadius="2"
            Focusable="True"
            IsTabStop="False">
        <Border.ContextFlyout>
            <Flyout Placement="Pointer" ShowMode="Standard">
                <Border Background="#FAFAFA" BorderBrush="#30000000" BorderThickness="1" CornerRadius="4" Padding="6">
                    <StackPanel Spacing="6">
                        <!-- Actions row -->
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Border Classes="iconBtn" ToolTip.Tip="New note" PointerPressed="OnNewIconPressed">
                                <Path Data="M2.5 1A1.5 1.5 0 0 0 1 2.5v11A1.5 1.5 0 0 0 2.5 15h6.086a1.5 1.5 0 0 0 1.06-.44l4.915-4.914A1.5 1.5 0 0 0 15 8.586V2.5A1.5 1.5 0 0 0 13.5 1zM2 2.5a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 .5.5V8H9.5A1.5 1.5 0 0 0 8 9.5V14H2.5a.5.5 0 0 1-.5-.5zm7 11.293V9.5a.5.5 0 0 1 .5-.5h4.293z"
                                      Fill="#333"
                                      Width="14" Height="14" Stretch="Uniform"
                                      RenderTransform="scale(-1,1)" RenderTransformOrigin="50%,50%"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Name="PinIconBorder" Classes="iconBtn" ToolTip.Tip="Pin on top" PointerPressed="OnPinIconPressed">
                                <Path Name="PinIcon"
                                      Data="M4.146.146A.5.5 0 0 1 4.5 0h7a.5.5 0 0 1 .5.5c0 .68-.342 1.174-.646 1.479-.126.125-.25.224-.354.298v4.431l.078.048c.203.127.476.314.751.555C12.36 7.775 13 8.527 13 9.5a.5.5 0 0 1-.5.5h-4v4.5c0 .276-.224 1.5-.5 1.5s-.5-1.224-.5-1.5V10h-4a.5.5 0 0 1-.5-.5c0-.973.64-1.725 1.17-2.189A6 6 0 0 1 5 6.708V2.277a3 3 0 0 1-.354-.298C4.342 1.674 4 1.179 4 .5a.5.5 0 0 1 .146-.354m1.58 1.408-.002-.001zm-.002-.001.002.001A.5.5 0 0 1 6 2v5a.5.5 0 0 1-.276.447h-.002l-.012.007-.054.03a5 5 0 0 0-.827.58c-.318.278-.585.596-.725.936h7.792c-.14-.34-.407-.658-.725-.936a5 5 0 0 0-.881-.61l-.012-.006h-.002A.5.5 0 0 1 10 7V2a.5.5 0 0 1 .295-.458 1.8 1.8 0 0 0 .351-.271c.08-.08.155-.17.214-.271H5.14q.091.15.214.271a1.8 1.8 0 0 0 .37.282"
                                      Fill="#333"
                                      Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Name="LockIconBorder" Classes="iconBtn" ToolTip.Tip="Lock in place" PointerPressed="OnLockIconPressed">
                                <Path Name="LockIcon"
                                      Data="F0 M8 0a4 4 0 0 1 4 4v2.05a2.5 2.5 0 0 1 2 2.45v5a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 2 13.5v-5a2.5 2.5 0 0 1 2-2.45V4a4 4 0 0 1 4-4M4.5 7A1.5 1.5 0 0 0 3 8.5v5A1.5 1.5 0 0 0 4.5 15h7a1.5 1.5 0 0 0 1.5-1.5v-5A1.5 1.5 0 0 0 11.5 7zM8 1a3 3 0 0 0-3 3v2h6V4a3 3 0 0 0-3-3"
                                      Fill="#333"
                                      Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Name="DeleteIconBorder" Classes="iconBtn" ToolTip.Tip="Delete" PointerPressed="OnDeleteIconPressed">
                                <Path Name="DeleteIcon"
                                      Data="M14 2H10C10 0.897 9.103 0 8 0C6.897 0 6 0.897 6 2H2C1.724 2 1.5 2.224 1.5 2.5C1.5 2.776 1.724 3 2 3H2.54L3.349 12.708C3.456 13.994 4.55 15 5.84 15H10.159C11.449 15 12.543 13.993 12.65 12.708L13.459 3H13.999C14.275 3 14.499 2.776 14.499 2.5C14.499 2.224 14.275 2 13.999 2H14ZM8 1C8.551 1 9 1.449 9 2H7C7 1.449 7.449 1 8 1ZM11.655 12.625C11.591 13.396 10.934 14 10.16 14H5.841C5.067 14 4.41 13.396 4.346 12.625L3.544 3H12.458L11.656 12.625H11.655ZM7 5.5V11.5C7 11.776 6.776 12 6.5 12C6.224 12 6 11.776 6 11.5V5.5C6 5.224 6.224 5 6.5 5C6.776 5 7 5.224 7 5.5ZM10 5.5V11.5C10 11.776 9.776 12 9.5 12C9.224 12 9 11.776 9 11.5V5.5C9 5.224 9.224 5 9.5 5C9.776 5 10 5.224 10 5.5Z"
                                      Fill="#333"
                                      Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Classes="iconBtn" ToolTip.Tip="Recycle bin" PointerPressed="OnBinIconPressed">
                                <Path Data="M184.561 261.903c3.232 13.997-12.123 24.635-24.068 17.168l-40.736-25.455-50.867 81.402C55.606 356.273 70.96 384 96.012 384H148c6.627 0 12 5.373 12 12v40c0 6.627-5.373 12-12 12H96.115c-75.334 0-121.302-83.048-81.408-146.88l50.822-81.388-40.725-25.448c-12.081-7.547-8.966-25.961 4.879-29.158l110.237-25.45c8.611-1.988 17.201 3.381 19.189 11.99l25.452 110.237zm98.561-182.915l41.289 66.076-40.74 25.457c-12.051 7.528-9 25.953 4.879 29.158l110.237 25.45c8.672 1.999 17.215-3.438 19.189-11.99l25.45-110.237c3.197-13.844-11.99-24.719-24.068-17.168l-40.687 25.424-41.263-66.082c-37.521-60.033-125.209-60.171-162.816 0l-17.963 28.766c-3.51 5.62-1.8 13.021 3.82 16.533l33.919 21.195c5.62 3.512 13.024 1.803 16.536-3.817l17.961-28.743c12.712-20.341 41.973-19.676 54.257-.022zM497.288 301.12l-27.515-44.065c-3.511-5.623-10.916-7.334-16.538-3.821l-33.861 21.159c-5.62 3.512-7.33 10.915-3.818 16.536l27.564 44.112c13.257 21.211-2.057 48.96-27.136 48.96H320V336.02c0-14.213-17.242-21.383-27.313-11.313l-80 79.981c-6.249 6.248-6.249 16.379 0 22.627l80 79.989C302.689 517.308 320 510.3 320 495.989V448h95.88c75.274 0 121.335-82.997 81.408-146.88z"
                                      Fill="#333"
                                      Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Classes="iconBtn" ToolTip.Tip="Settings" PointerPressed="OnSettingsIconPressed">
                                <Path Data="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                                      Stroke="#333" StrokeThickness="1.0" Fill="Transparent"
                                      StrokeJoin="Round" StrokeLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <!-- Colors row -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,2,0">
                            <Ellipse Name="Sw1" Tag="#FFF59E" Width="20" Height="20" Fill="#FFF59E" Stroke="#60000000" StrokeThickness="1" Cursor="Hand" PointerPressed="OnSwatchPressed" ToolTip.Tip="Yellow"/>
                            <Ellipse Name="Sw2" Tag="#FFB6C1" Width="20" Height="20" Fill="#FFB6C1" Stroke="#60000000" StrokeThickness="1" Cursor="Hand" PointerPressed="OnSwatchPressed" ToolTip.Tip="Pink"/>
                            <Ellipse Name="Sw3" Tag="#A8DADC" Width="20" Height="20" Fill="#A8DADC" Stroke="#60000000" StrokeThickness="1" Cursor="Hand" PointerPressed="OnSwatchPressed" ToolTip.Tip="Blue"/>
                            <Ellipse Name="Sw4" Tag="#B7E4C7" Width="20" Height="20" Fill="#B7E4C7" Stroke="#60000000" StrokeThickness="1" Cursor="Hand" PointerPressed="OnSwatchPressed" ToolTip.Tip="Green"/>
                            <Ellipse Name="Sw5" Tag="#D3D3D3" Width="20" Height="20" Fill="#D3D3D3" Stroke="#60000000" StrokeThickness="1" Cursor="Hand" PointerPressed="OnSwatchPressed" ToolTip.Tip="Gray"/>
                            <Border Name="SwCustom" Width="20" Height="20" CornerRadius="10" Background="#F0F0F0" BorderBrush="#60000000" BorderThickness="1" Cursor="Hand" PointerPressed="OnCustomColorPressed" ToolTip.Tip="Custom color…">
                                <TextBlock Text="…" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#444" Margin="0,-4,0,0"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Flyout>
        </Border.ContextFlyout>
        <Grid x:Name="BodyGrid" RowDefinitions="22,*" UseLayoutRounding="True">
            <Border Grid.Row="0"
                    Name="HeaderBar"
                    Background="#FFEB80"
                    UseLayoutRounding="True"
                    PointerPressed="OnDragBarPressed"/>

            <TextBox Grid.Row="1"
                     Name="NoteText"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="12,8,12,18"
                     FontSize="14"
                     Foreground="#1a1a1a"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     TextChanged="OnTextChanged"/>

            <ScrollViewer Grid.Row="1"
                          Name="RenderedScroll"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="False"
                          PointerPressed="OnRenderedTextPressed">
                <TextBlock Name="RenderedText"
                           Background="Transparent"
                           Padding="12,8,12,18"
                           FontSize="14"
                           Foreground="#1a1a1a"
                           TextWrapping="Wrap"/>
            </ScrollViewer>

            <Border Grid.Row="1"
                    Width="14" Height="14"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Cursor="BottomRightCorner"
                    PointerPressed="OnResizeGripPressed">
                <Path Data="M 14,0 L 14,14 L 0,14 Z"
                      Fill="#33000000"
                      Stretch="Fill"/>
            </Border>

        </Grid>
    </Border>
</Window>
