<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Stickies.Views.MainWindow"
        Width="280" Height="280"
        MinWidth="180" MinHeight="140"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif"
        Title="Sticky">

  <Border Name="BodyBorder"
            Background="#FFF59E"
            BoxShadow="0 14 14 0 #50000000"
            CornerRadius="2"
            Focusable="True"
            IsTabStop="False">
        <Border.ContextMenu>
            <ContextMenu Name="NoteMenu">
                <MenuItem Name="NewMenuItem" Header="New note" Click="OnNewClick"/>
                <MenuItem Name="PinMenuItem" Click="OnPinClick"/>
                <Separator/>
                <MenuItem Padding="6,4" StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Name="Sw1" Tag="#FFF59E" Width="20" Height="20" Fill="#FFF59E" Stroke="#60000000" StrokeThickness="1" Cursor="Hand" PointerPressed="OnSwatchPressed" ToolTip.Tip="Yellow"/>
                            <Ellipse Name="Sw2" Tag="#FFB6C1" Width="20" Height="20" Fill="#FFB6C1" Stroke="#60000000" StrokeThickness="1" Cursor="Hand" PointerPressed="OnSwatchPressed" ToolTip.Tip="Pink"/>
                            <Ellipse Name="Sw3" Tag="#A8DADC" Width="20" Height="20" Fill="#A8DADC" Stroke="#60000000" StrokeThickness="1" Cursor="Hand" PointerPressed="OnSwatchPressed" ToolTip.Tip="Blue"/>
                            <Ellipse Name="Sw4" Tag="#B7E4C7" Width="20" Height="20" Fill="#B7E4C7" Stroke="#60000000" StrokeThickness="1" Cursor="Hand" PointerPressed="OnSwatchPressed" ToolTip.Tip="Green"/>
                            <Ellipse Name="Sw5" Tag="#D3D3D3" Width="20" Height="20" Fill="#D3D3D3" Stroke="#60000000" StrokeThickness="1" Cursor="Hand" PointerPressed="OnSwatchPressed" ToolTip.Tip="Gray"/>
                            <Border Name="SwCustom" Width="20" Height="20" CornerRadius="10" Background="#F0F0F0" BorderBrush="#60000000" BorderThickness="1" Cursor="Hand" PointerPressed="OnCustomColorPressed" ToolTip.Tip="Custom color…">
                                <TextBlock Text="…" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#444" Margin="0,-4,0,0"/>
                            </Border>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Name="DeleteMenuItem" Header="Delete" Click="OnDeleteClick"/>
                <MenuItem Name="LockMenuItem" Header="Lock in place" Click="OnLockToggleClick"/>
                <!-- TODO(bpy): move bin entry to compact menu -->
                <MenuItem Name="BinMenuItem" Header="Show recycle bin" Click="OnShowBinClick"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid x:Name="BodyGrid" RowDefinitions="22,*">
            <Border Grid.Row="0"
                    Name="HeaderBar"
                    Background="#FFEB80"
                    PointerPressed="OnDragBarPressed"/>

            <TextBox Grid.Row="1"
                     Name="NoteText"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="12,8,12,18"
                     FontSize="14"
                     Foreground="#1a1a1a"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     TextChanged="OnTextChanged"/>

            <ScrollViewer Grid.Row="1"
                          Name="RenderedScroll"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="False"
                          PointerPressed="OnRenderedTextPressed">
                <TextBlock Name="RenderedText"
                           Background="Transparent"
                           Padding="12,8,12,18"
                           FontSize="14"
                           Foreground="#1a1a1a"
                           TextWrapping="Wrap"/>
            </ScrollViewer>

            <Border Grid.Row="1"
                    Width="14" Height="14"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Cursor="BottomRightCorner"
                    PointerPressed="OnResizeGripPressed">
                <Path Data="M 14,0 L 14,14 L 0,14 Z"
                      Fill="#33000000"
                      Stretch="Fill"/>
            </Border>

        </Grid>
    </Border>
</Window>
